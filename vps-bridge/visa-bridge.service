[Unit]
Description=Visa Bypass rotation bridge
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/visa-bridge
ExecStart=/usr/bin/node /opt/visa-bridge/local-bridge.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
